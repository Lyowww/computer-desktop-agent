# Backend Socket.IO URL (ws/wss or http/https). `/ws` is added automatically if missing.
AGENT_BACKEND_URL=wss://computer-agent-backend.onrender.com

# Optional override for device display name
AGENT_DEVICE_NAME=

# Device token from web dashboard: Devices → Add device (shown once).
# Paste the token here OR use the Connect window in the tray app.
AGENT_DEVICE_TOKEN=
