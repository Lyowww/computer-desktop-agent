# Optional for local development only.
# Packaged DMG users enter device name + token in the Setup window (no .env needed).

# Backend Socket.IO URL (ws/wss or http/https). `/ws` is added automatically if missing.
AGENT_BACKEND_URL=wss://computer-agent-backend.onrender.com

# Optional override for device display name (prefer Setup / Settings UI)
AGENT_DEVICE_NAME=

# Optional one-time token for local dev only (prefer Setup / Settings UI)
AGENT_DEVICE_TOKEN=
